            },
            "east": {
              "pool": "halls",
              "required": true
            }
          }
        },
        "hideComponents": [
          "roof"
        ],
        "views": [
          "isometric",
          "front"
        ],
        "overlays": [
          "lighting",
          "access",
          "ports"
        ]
      }
    },
    {
      "tool": "worldsmith_validate_architecture",
      "arguments": {
        "sessionId": "$SESSION"
      }
    },
    {
      "tool": "worldsmith_get_content_draft",
      "arguments": {
        "sessionId": "$SESSION"
      },
      "capture": {
        "CONTENT_REVISION": "/revision"
      }
    },
    {
      "tool": "worldsmith_write_pack",
      "arguments": {
        "sessionId": "$SESSION",
        "displayName": "Authoring workbench example",
        "terrain": "$TERRAIN",
        "biomes": "$BIOMES",
        "features": "$FEATURES",
        "expectedRevision": "$CONTENT_REVISION",
        "theme": "$THEME"
      }
    },
    {
      "tool": "worldsmith_authoring_stats",
      "arguments": {
        "sessionId": "$SESSION"
      }
    },
    {
      "tool": "worldsmith_finish_world",
      "arguments": {
        "sessionId": "$SESSION"
      }
    }
  ]
}
