{
  "note": "Authoring design fixture only: not generated runtime modules, a completed resource pack, or playtest evidence.",
  "prompt": "创建一个灵晶衰竭的古风世界，包含古城遗迹、晶核守卫和两章连贯主线；最终奖励可主动治疗的护符，不需要 Boss。",
  "bible": {
    "title": "残辉古城：最后的灵晶",
    "premise": "古城曾靠灵晶驱动工坊与守卫。矿脉衰竭后，城民离去，失衡的守卫仍在保护早已停产的矿场。",
    "playerRole": "寻找古城衰落原因的行路人",
    "mainConflict": "回收残存灵晶与失衡晶核，在保护遗迹和获得生存力量之间找到出路。",
    "requirements": [
      {
        "id": "ruins",
        "text": "古城遗迹必须有矿业历史和实际探索用途",
        "promptQuote": "古城遗迹"
      },
      {
        "id": "mainline",
        "text": "两章任务有前后因果而非无关收集",
        "promptQuote": "两章连贯主线"
      },
      {
        "id": "healing",
        "text": "最终护符具有已安装的主动治疗能力",
        "promptQuote": "可主动治疗的护符"
      },
      {
        "id": "no_boss",
        "text": "使用普通守卫遭遇，不要求Boss",
        "promptQuote": "不需要 Boss"
      }
    ],
    "assumptions": [
      "灵晶是材料与历史线索，不新增可耗竭的全局能源模拟。",
      "古城居民仅作为历史设定，不新增NPC对话或交易机制。"
    ],
    "requiresBoss": false,
    "openDecisions": [],
    "nodes": [
      {
        "id": "crystal_law",
        "kind": "RULE",
        "title": "余辉有限",
        "description": "灵晶的失衡体现在矿地色调、遗迹用途和守卫行为上；护符只使用现有USE治疗动作，不能凭故事安装世界净化机制。"
      },
      {
        "id": "decline",
        "kind": "HISTORY",
        "title": "矿城停摆",
        "description": "矿脉衰竭使运输与工坊停摆，守卫失衡是同一历史事件的后果。",
        "dependsOn": [
          "crystal_law"
        ]
      },
      {
        "id": "plain",
        "kind": "REGION",
        "title": "黯晶原",
        "description": "矿城周边有裸露石地、黯色晶体与稀疏植被，保留原版木材和食物的基本来源。",
        "dependsOn": [
          "decline"
        ]
      },
      {
        "id": "culture",
        "kind": "CULTURE",
        "title": "矿城工匠",
        "description": "采矿、储运与工坊建筑各有实际功能；古风屋顶与石质基座共同表达工业遗迹而不是一组同形房屋。",
        "dependsOn": [
          "decline"
        ]
      },
      {
        "id": "keeper",
        "kind": "ECOLOGY",
        "title": "晶核守卫",
        "description": "普通地面近战守卫出现在矿城地区，晶核与碎晶是其合理掉落；声音使用低音铁傀儡声线，不继承额外原版能力。",
        "dependsOn": [
          "plain",
          "crystal_law"
        ]
      },
      {
        "id": "resources",
        "kind": "RESOURCE",
        "title": "碎晶与晶核",
        "description": "矿场容器提供碎晶，守卫提供可重复的碎晶和晶核来源。任务先回收碎晶，再处理失衡守卫并交付晶核，避免依赖任务自身奖励。",
        "dependsOn": [
          "keeper",
          "culture"
        ]
      },
      {
        "id": "style",
        "kind": "STYLE",
        "title": "石灰与余辉",
        "description": "建筑用灰石和褪色木构，物品以黯青色晶体为共同材料语言；普通环境叫声克制，守卫攻击声只在击打时触发。",
        "dependsOn": [
          "crystal_law"
        ]
      },
      {
        "id": "journey",
        "kind": "EXPERIENCE",
        "title": "从碎晶到护符",
        "description": "第一章回收三枚碎晶，说明矿城曾如何运作；第二章击败一名已失衡守卫并交付晶核，领取可主动治疗的余辉护符。完成任务不宣称地形或古城自动修复。",
        "dependsOn": [
          "resources",
          "decline"
        ]
      }
    ]
  },
